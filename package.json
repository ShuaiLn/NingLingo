{
  "name": "ninglingo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:check": "node scripts/migrate-cloud.mjs --check",
    "db:migrate": "node scripts/migrate-cloud.mjs",
    "grammar:build": "node scripts/grammar-build.mjs",
    "grammar:validate": "node --experimental-strip-types scripts/grammar-validate.mjs",
    "grammar:import": "node --experimental-strip-types scripts/grammar-import.mjs",
    "security:bundle": "node scripts/check-client-secrets.mjs",
    "test:cloud": "node scripts/verify-cloud.mjs",
    "test:cloud:alphabet": "node scripts/verify-alphabet-cloud.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
